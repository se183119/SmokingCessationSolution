<Window x:Class="WPF.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Bảng điều khiển - Smoking Cessation Platform" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Bảng điều khiển của bạn" Style="{StaticResource HeaderText}"/>
            <TextBlock x:Name="WelcomeText" Text="Chào mừng trở lại!" Style="{StaticResource SecondaryText}"/>
        </StackPanel>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Quick Stats Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Days Smoke-Free -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" 
                          Background="{StaticResource SuccessBrush}" Margin="5">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🎯" FontSize="24"/>
                                <TextBlock Text="Ngày không thuốc" 
                                         Foreground="White" 
                                         FontFamily="{StaticResource PrimaryFont}"
                                         FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="DaysSmokeFreeText" Text="15" 
                                     Foreground="White" 
                                     FontSize="32" 
                                     FontWeight="Bold"/>
                            <TextBlock Text="Tuyệt vời! Tiếp tục phát huy!" 
                                     Foreground="White" 
                                     FontSize="12" 
                                     Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Money Saved -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" 
                          Background="{StaticResource AccentBrush}" Margin="5">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💰" FontSize="24"/>
                                <TextBlock Text="Tiền tiết kiệm" 
                                         Foreground="White" 
                                         FontFamily="{StaticResource PrimaryFont}"
                                         FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="MoneySavedText" Text="450,000" 
                                     Foreground="White" 
                                     FontSize="24" 
                                     FontWeight="Bold"/>
                            <TextBlock Text="VNĐ" 
                                     Foreground="White" 
                                     FontSize="14" 
                                     Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Health Improvement -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" 
                          Background="{StaticResource PrimaryBrush}" Margin="5">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="❤️" FontSize="24"/>
                                <TextBlock Text="Cải thiện sức khỏe" 
                                         Foreground="White" 
                                         FontFamily="{StaticResource PrimaryFont}"
                                         FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="HealthScoreText" Text="78%" 
                                     Foreground="White" 
                                     FontSize="32" 
                                     FontWeight="Bold"/>
                            <TextBlock Text="Chức năng phổi đã cải thiện" 
                                     Foreground="White" 
                                     FontSize="12" 
                                     Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Streak -->
                    <Border Grid.Column="3" Style="{StaticResource Card}" 
                          Background="{StaticResource PrimaryLightBrush}" Margin="5">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔥" FontSize="24"/>
                                <TextBlock Text="Chuỗi ngày" 
                                         Foreground="White" 
                                         FontFamily="{StaticResource PrimaryFont}"
                                         FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="StreakText" Text="15" 
                                     Foreground="White" 
                                     FontSize="32" 
                                     FontWeight="Bold"/>
                            <TextBlock Text="Kỷ lục cá nhân!" 
                                     Foreground="White" 
                                     FontSize="12" 
                                     Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Charts Section -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Progress Chart -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                <TextBlock Text="Tiến độ 30 ngày qua" Style="{StaticResource SubHeaderText}"/>
                                <ComboBox x:Name="ChartTypeComboBox" 
                                        MinWidth="120"
                                        SelectedIndex="0"
                                        SelectionChanged="ChartTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Ngày không thuốc"/>
                                    <ComboBoxItem Content="Tiền tiết kiệm"/>
                                    <ComboBoxItem Content="Sức khỏe"/>
                                    <ComboBoxItem Content="Cảm xúc"/>
                                </ComboBox>
                            </StackPanel>
                            
                            <!-- Simple Chart Representation -->
                            <Border Height="250" Background="#F5F5F5" CornerRadius="4">
                                <Canvas x:Name="ChartCanvas">
                                    <!-- Sample chart points -->
                                    <Rectangle Canvas.Left="20" Canvas.Bottom="20" Width="15" Height="50" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="40" Canvas.Bottom="20" Width="15" Height="80" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="60" Canvas.Bottom="20" Width="15" Height="60" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="80" Canvas.Bottom="20" Width="15" Height="100" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="100" Canvas.Bottom="20" Width="15" Height="120" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="120" Canvas.Bottom="20" Width="15" Height="90" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    <Rectangle Canvas.Left="140" Canvas.Bottom="20" Width="15" Height="140" 
                                             Fill="{StaticResource PrimaryBrush}"/>
                                    
                                    <!-- Chart Labels -->
                                    <TextBlock Canvas.Left="20" Canvas.Bottom="5" Text="T2" FontSize="10"/>
                                    <TextBlock Canvas.Left="40" Canvas.Bottom="5" Text="T3" FontSize="10"/>
                                    <TextBlock Canvas.Left="60" Canvas.Bottom="5" Text="T4" FontSize="10"/>
                                    <TextBlock Canvas.Left="80" Canvas.Bottom="5" Text="T5" FontSize="10"/>
                                    <TextBlock Canvas.Left="100" Canvas.Bottom="5" Text="T6" FontSize="10"/>
                                    <TextBlock Canvas.Left="120" Canvas.Bottom="5" Text="T7" FontSize="10"/>
                                    <TextBlock Canvas.Left="140" Canvas.Bottom="5" Text="CN" FontSize="10"/>
                                </Canvas>
                            </Border>
                            
                            <!-- Chart Legend -->
                            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Rectangle Width="12" Height="12" Fill="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Tiến độ hàng ngày" Style="{StaticResource BodyText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Rectangle Width="12" Height="12" Fill="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text="Mục tiêu" Style="{StaticResource BodyText}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Quick Actions & Goals -->
                    <StackPanel Grid.Column="1" Spacing="15" Margin="10,0,0,0">
                        <!-- Today's Goals -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Mục tiêu hôm nay" Style="{StaticResource SubHeaderText}"/>
                                
                                <StackPanel Spacing="10">
                                    <!-- Goal 1 -->
                                    <Border Background="#E8F5E8" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <CheckBox Content="Không hút thuốc" 
                                                    IsChecked="True" 
                                                    FontFamily="{StaticResource PrimaryFont}"/>
                                            <TextBlock Text="✅ Hoàn thành" 
                                                     Foreground="{StaticResource SuccessBrush}" 
                                                     FontSize="11" 
                                                     Margin="20,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Goal 2 -->
                                    <Border Background="#FFF3E0" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <CheckBox Content="Tập thể dục 30 phút" 
                                                    IsChecked="False" 
                                                    FontFamily="{StaticResource PrimaryFont}"/>
                                            <ProgressBar Value="60" Maximum="100" 
                                                       Height="4" 
                                                       Foreground="{StaticResource AccentBrush}" 
                                                       Margin="20,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Goal 3 -->
                                    <Border Background="#E3F2FD" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <CheckBox Content="Uống 8 ly nước" 
                                                    IsChecked="False" 
                                                    FontFamily="{StaticResource PrimaryFont}"/>
                                            <ProgressBar Value="30" Maximum="100" 
                                                       Height="4" 
                                                       Foreground="{StaticResource PrimaryBrush}" 
                                                       Margin="20,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                
                                <Button Content="Cập nhật tiến độ" 
                                      Style="{StaticResource PrimaryButton}"
                                      Click="UpdateProgressButton_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Quick Actions -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Hành động nhanh" Style="{StaticResource SubHeaderText}"/>
                                
                                <StackPanel Spacing="8">
                                    <Button Content="📝 Ghi nhận tiến độ" 
                                          Style="{StaticResource SecondaryButton}"
                                          HorizontalAlignment="Stretch"
                                          Click="LogProgressButton_Click"/>
                                    <Button Content="🎯 Xem kế hoạch" 
                                          Style="{StaticResource SecondaryButton}"
                                          HorizontalAlignment="Stretch"
                                          Click="ViewPlanButton_Click"/>
                                    <Button Content="💬 Tư vấn" 
                                          Style="{StaticResource SecondaryButton}"
                                          HorizontalAlignment="Stretch"
                                          Click="ConsultationButton_Click"/>
                                    <Button Content="🏆 Thành tích" 
                                          Style="{StaticResource SecondaryButton}"
                                          HorizontalAlignment="Stretch"
                                          Click="AchievementsButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                
                <!-- Bottom Section -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Recent Activities -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                <TextBlock Text="Hoạt động gần đây" Style="{StaticResource SubHeaderText}"/>
                                <Button Content="Xem tất cả" 
                                      Style="{StaticResource SecondaryButton}"
                                      Padding="8,4" FontSize="12"
                                      Click="ViewAllActivitiesButton_Click"/>
                            </StackPanel>
                            
                            <StackPanel Spacing="10">
                                <!-- Activity 1 -->
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="Hoàn thành mục tiêu ngày" FontWeight="SemiBold"/>
                                            <TextBlock Text="Đã không hút thuốc suốt ngày" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Hôm nay" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Activity 2 -->
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🏃" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="Tập thể dục 45 phút" FontWeight="SemiBold"/>
                                            <TextBlock Text="Chạy bộ trong công viên" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Hôm qua" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Activity 3 -->
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🎯" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="Đạt mốc 14 ngày" FontWeight="SemiBold"/>
                                            <TextBlock Text="Mốc quan trọng đầu tiên" FontSize="12" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Hôm qua" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Health Tips & Motivation -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Mẹo sức khỏe hôm nay" Style="{StaticResource SubHeaderText}"/>
                            
                            <!-- Daily Tip -->
                            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="💡" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Uống nhiều nước" 
                                             Foreground="White" 
                                             FontWeight="Bold" 
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Nước giúp cơ thể loại bỏ độc tố từ thuốc lá và giảm cảm giác thèm thuốc." 
                                             Foreground="White" 
                                             TextWrapping="Wrap" 
                                             TextAlignment="Center"
                                             FontSize="13" 
                                             Opacity="0.9"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Motivational Quote -->
                            <Border Background="#F3E5F5" CornerRadius="8" Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="🌟" FontSize="20" HorizontalAlignment="Center"/>
                                    <TextBlock Text="&quot;Mỗi ngày không thuốc là một chiến thắng!&quot;" 
                                             FontStyle="Italic" 
                                             FontWeight="SemiBold" 
                                             HorizontalAlignment="Center"
                                             TextAlignment="Center"
                                             TextWrapping="Wrap"/>
                                    <TextBlock Text="Bạn đang làm rất tốt!" 
                                             HorizontalAlignment="Center" 
                                             FontSize="12" 
                                             Opacity="0.7"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Emergency Help -->
                            <Border Background="{StaticResource ErrorBrush}" CornerRadius="8" Padding="15">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🆘 Khẩn cấp" 
                                             Foreground="White" 
                                             FontWeight="Bold" 
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="Cảm thấy muốn hút thuốc?" 
                                             Foreground="White" 
                                             HorizontalAlignment="Center" 
                                             FontSize="13"/>
                                    <Button Content="Nhận hỗ trợ ngay" 
                                          Background="White" 
                                          Foreground="{StaticResource ErrorBrush}"
                                          BorderThickness="0" 
                                          Padding="12,6" 
                                          FontSize="12" 
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Center"
                                          Click="EmergencyHelpButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>