<Window x:Class="WPF.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Giới thiệu - Smoking Cessation Platform" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="30" Margin="40">
            <!-- Hero Section -->
            <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Spacing="20" Margin="40">
                        <TextBlock Text="Smoking Cessation Platform" 
                                 Foreground="White" 
                                 FontFamily="{StaticResource PrimaryFont}"
                                 FontSize="36" FontWeight="Bold"/>
                        <TextBlock Text="Hành trình cai thuốc lá thành công với sự hỗ trợ khoa học và cộng đồng" 
                                 Foreground="White" 
                                 FontFamily="{StaticResource PrimaryFont}"
                                 FontSize="18" 
                                 TextWrapping="Wrap" 
                                 Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,20,0,0">
                            <Button Content="Bắt đầu ngay" 
                                  Background="White" 
                                  Foreground="{StaticResource PrimaryBrush}"
                                  Padding="20,10" 
                                  FontSize="16" 
                                  FontWeight="SemiBold"
                                  BorderThickness="0" 
                                  Cursor="Hand"
                                  Click="GetStartedButton_Click"/>
                            <Button Content="Tìm hiểu thêm" 
                                  Background="Transparent" 
                                  Foreground="White"
                                  BorderBrush="White" 
                                  BorderThickness="2"
                                  Padding="20,10" 
                                  FontSize="16"
                                  Cursor="Hand"
                                  Click="LearnMoreButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Hero Image Placeholder -->
                    <Border Grid.Column="1" Background="White" 
                          CornerRadius="10" Opacity="0.9" 
                          Margin="20" Height="200">
                        <TextBlock Text="🌟" FontSize="80" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Features Section -->
            <StackPanel Spacing="20">
                <TextBlock Text="Tính năng nổi bật" 
                         Style="{StaticResource HeaderText}" 
                         HorizontalAlignment="Center"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Feature 1 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="10">
                        <StackPanel Spacing="15" HorizontalAlignment="Center">
                            <Ellipse Width="60" Height="60" Fill="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="📊" FontSize="30" HorizontalAlignment="Center" Margin="0,-45,0,0"/>
                            <TextBlock Text="Theo dõi tiến độ" 
                                     Style="{StaticResource SubHeaderText}" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Ghi nhận và theo dõi tiến trình cai thuốc hàng ngày với biểu đồ trực quan" 
                                     Style="{StaticResource BodyText}" 
                                     TextWrapping="Wrap" 
                                     TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Feature 2 -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10">
                        <StackPanel Spacing="15" HorizontalAlignment="Center">
                            <Ellipse Width="60" Height="60" Fill="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="🎯" FontSize="30" HorizontalAlignment="Center" Margin="0,-45,0,0"/>
                            <TextBlock Text="Kế hoạch cá nhân" 
                                     Style="{StaticResource SubHeaderText}" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Tạo kế hoạch cai thuốc phù hợp với tình trạng và mục tiêu cá nhân" 
                                     Style="{StaticResource BodyText}" 
                                     TextWrapping="Wrap" 
                                     TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Feature 3 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10">
                        <StackPanel Spacing="15" HorizontalAlignment="Center">
                            <Ellipse Width="60" Height="60" Fill="{StaticResource AccentBrush}"/>
                            <TextBlock Text="👥" FontSize="30" HorizontalAlignment="Center" Margin="0,-45,0,0"/>
                            <TextBlock Text="Hỗ trợ chuyên gia" 
                                     Style="{StaticResource SubHeaderText}" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Tư vấn từ các chuyên gia và huấn luyện viên có kinh nghiệm" 
                                     Style="{StaticResource BodyText}" 
                                     TextWrapping="Wrap" 
                                     TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Feature 4 -->
                    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="10">
                        <StackPanel Spacing="15" HorizontalAlignment="Center">
                            <Ellipse Width="60" Height="60" Fill="{StaticResource PrimaryLightBrush}"/>
                            <TextBlock Text="🏆" FontSize="30" HorizontalAlignment="Center" Margin="0,-45,0,0"/>
                            <TextBlock Text="Thành tích & Động lực" 
                                     Style="{StaticResource SubHeaderText}" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Hệ thống huy hiệu và thành tích để duy trì động lực" 
                                     Style="{StaticResource BodyText}" 
                                     TextWrapping="Wrap" 
                                     TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            
            <!-- Statistics Section -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="20">
                    <TextBlock Text="Thống kê thành công" 
                             Style="{StaticResource HeaderText}" 
                             HorizontalAlignment="Center"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Success Rate -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="78%" 
                                     Foreground="{StaticResource SuccessBrush}" 
                                     FontSize="48" 
                                     FontWeight="Bold" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Tỷ lệ thành công" 
                                     Style="{StaticResource BodyText}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Total Members -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="2,456" 
                                     Foreground="{StaticResource PrimaryBrush}" 
                                     FontSize="48" 
                                     FontWeight="Bold" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Thành viên đã tham gia" 
                                     Style="{StaticResource BodyText}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Money Saved -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="15.2B" 
                                     Foreground="{StaticResource AccentBrush}" 
                                     FontSize="48" 
                                     FontWeight="Bold" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="VNĐ đã tiết kiệm" 
                                     Style="{StaticResource BodyText}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Smoke-free Days -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="10">
                            <TextBlock Text="156K" 
                                     Foreground="{StaticResource PrimaryLightBrush}" 
                                     FontSize="48" 
                                     FontWeight="Bold" 
                                     HorizontalAlignment="Center"/>
                            <TextBlock Text="Ngày không thuốc" 
                                     Style="{StaticResource BodyText}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Leaderboard Section -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                        <TextBlock Text="Bảng xếp hạng tháng này" Style="{StaticResource HeaderText}"/>
                        <Button Content="Xem tất cả" 
                              Style="{StaticResource SecondaryButton}"
                              Click="ViewAllLeaderboardButton_Click"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Top Users -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="Người dùng xuất sắc" Style="{StaticResource SubHeaderText}"/>
                            
                            <!-- Top 1 -->
                            <Border Background="#FFD700" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥇" FontSize="20"/>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Nguyễn Văn Minh" FontWeight="Bold"/>
                                        <TextBlock Text="Cai thuốc thành công 90 ngày" FontSize="12" Opacity="0.8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="90 ngày" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            
                            <!-- Top 2 -->
                            <Border Background="#C0C0C0" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥈" FontSize="20"/>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Trần Thị Lan" FontWeight="Bold"/>
                                        <TextBlock Text="Tiết kiệm được 2.5M VNĐ" FontSize="12" Opacity="0.8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="75 ngày" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            
                            <!-- Top 3 -->
                            <Border Background="#CD7F32" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🥉" FontSize="20"/>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="Lê Hoàng Nam" FontWeight="Bold"/>
                                        <TextBlock Text="Đạt mức tiến độ 95%" FontSize="12" Opacity="0.8"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="68 ngày" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <!-- Recent Achievements -->
                        <StackPanel Grid.Column="1" Spacing="10" Margin="20,0,0,0">
                            <TextBlock Text="Thành tích gần đây" Style="{StaticResource SubHeaderText}"/>
                            
                            <StackPanel Spacing="8">
                                <Border Background="#E8F5E8" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Mốc 30 ngày không thuốc" FontWeight="SemiBold"/>
                                        <TextBlock Text="Phạm Văn Đức - 2 giờ trước" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="#FFF3E0" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="💰 Tiết kiệm 1 triệu VNĐ" FontWeight="SemiBold"/>
                                        <TextBlock Text="Võ Thị Mai - 5 giờ trước" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="#E3F2FD" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="⭐ Hoàn thành kế hoạch tuần" FontWeight="SemiBold"/>
                                        <TextBlock Text="Đinh Quang Hải - 1 ngày trước" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="#F3E5F5" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🏃 7 ngày tập thể dục" FontWeight="SemiBold"/>
                                        <TextBlock Text="Bùi Thị Hoa - 1 ngày trước" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Call to Action -->
            <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryLightBrush}">
                <StackPanel Spacing="20" HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="Sẵn sàng bắt đầu hành trình cai thuốc?" 
                             Foreground="White" 
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="24" 
                             FontWeight="Bold" 
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Tham gia cộng đồng hàng nghìn người đã thành công cai thuốc lá" 
                             Foreground="White" 
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="16" 
                             HorizontalAlignment="Center" 
                             Opacity="0.9"/>
                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <Button Content="Đăng ký ngay" 
                              Background="White" 
                              Foreground="{StaticResource PrimaryBrush}"
                              Padding="25,12" 
                              FontSize="16" 
                              FontWeight="SemiBold"
                              BorderThickness="0" 
                              Cursor="Hand"
                              Click="RegisterNowButton_Click"/>
                        <Button Content="Liên hệ tư vấn" 
                              Background="Transparent" 
                              Foreground="White"
                              BorderBrush="White" 
                              BorderThickness="2"
                              Padding="25,12" 
                              FontSize="16"
                              Cursor="Hand"
                              Click="ContactButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>