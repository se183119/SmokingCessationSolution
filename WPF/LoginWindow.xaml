<Window x:Class="WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Smoking Cessation Platform - Đăng nhập" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Background Image/Pattern -->
        <Grid Grid.ColumnSpan="3" Opacity="0.1">
            <Rectangle Fill="{StaticResource PrimaryBrush}"/>
        </Grid>
        
        <!-- Login Form -->
        <Border Grid.Column="1" Style="{StaticResource Card}" 
                VerticalAlignment="Center" Margin="20">
            <StackPanel Spacing="20">
                <!-- Logo and Title -->
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Ellipse Width="80" Height="80" Fill="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Smoking Cessation Platform" 
                             Style="{StaticResource HeaderText}"
                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Cùng nhau chiến thắng thuốc lá" 
                             Style="{StaticResource SecondaryText}"
                             HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Login Form -->
                <StackPanel Spacing="15">
                    <TextBlock Text="Đăng nhập" Style="{StaticResource SubHeaderText}"/>
                    
                    <!-- Username -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Tên đăng nhập:" Style="{StaticResource BodyText}"/>
                        <TextBox x:Name="UsernameTextBox" 
                               Style="{StaticResource ModernTextBox}"
                               ToolTip="Nhập tên đăng nhập của bạn"/>
                    </StackPanel>
                    
                    <!-- Password -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Mật khẩu:" Style="{StaticResource BodyText}"/>
                        <PasswordBox x:Name="PasswordBox" 
                                   Style="{StaticResource ModernPasswordBox}"
                                   ToolTip="Nhập mật khẩu của bạn"/>
                    </StackPanel>
                    
                    <!-- Role Selection -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="Loại tài khoản:" Style="{StaticResource BodyText}"/>
                        <ComboBox x:Name="RoleComboBox" 
                                Padding="12,8"
                                FontFamily="{StaticResource PrimaryFont}"
                                FontSize="{StaticResource BodyFontSize}">
                            <ComboBoxItem Content="Thành viên" Tag="Member"/>
                            <ComboBoxItem Content="Huấn luyện viên" Tag="Coach"/>
                            <ComboBoxItem Content="Quản trị viên" Tag="Admin"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Remember Me -->
                    <CheckBox x:Name="RememberMeCheckBox" 
                            Content="Ghi nhớ đăng nhập"
                            FontFamily="{StaticResource PrimaryFont}"
                            FontSize="{StaticResource BodyFontSize}"/>
                    
                    <!-- Error Message -->
                    <TextBlock x:Name="ErrorMessageTextBlock" 
                             Foreground="{StaticResource ErrorBrush}"
                             Style="{StaticResource BodyText}"
                             Visibility="Collapsed"
                             TextWrapping="Wrap"/>
                    
                    <!-- Login Button -->
                    <Button x:Name="LoginButton" 
                          Content="Đăng nhập" 
                          Style="{StaticResource PrimaryButton}"
                          HorizontalAlignment="Stretch"
                          Margin="0,10,0,0"
                          Click="LoginButton_Click"/>
                    
                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10"/>
                    
                    <!-- Secondary Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                        <Button x:Name="RegisterButton" 
                              Content="Đăng ký tài khoản" 
                              Style="{StaticResource SecondaryButton}"
                              Click="RegisterButton_Click"/>
                        <Button x:Name="ForgotPasswordButton" 
                              Content="Quên mật khẩu?" 
                              Style="{StaticResource SecondaryButton}"
                              Click="ForgotPasswordButton_Click"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Loading Indicator -->
                <Grid x:Name="LoadingPanel" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="4" 
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Đang đăng nhập..." 
                             HorizontalAlignment="Center"
                             Style="{StaticResource SecondaryText}"
                             Margin="0,10,0,0"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Footer -->
        <StackPanel Grid.ColumnSpan="3" VerticalAlignment="Bottom" 
                  HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="© 2024 Smoking Cessation Platform. Tất cả quyền được bảo lưu." 
                     Style="{StaticResource SecondaryText}"
                     HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                      Spacing="10" Margin="0,5,0,0">
                <Button Content="Trợ giúp" Style="{StaticResource SecondaryButton}" 
                      Padding="8,4" FontSize="12"/>
                <Button Content="Điều khoản" Style="{StaticResource SecondaryButton}" 
                      Padding="8,4" FontSize="12"/>
                <Button Content="Bảo mật" Style="{StaticResource SecondaryButton}" 
                      Padding="8,4" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>