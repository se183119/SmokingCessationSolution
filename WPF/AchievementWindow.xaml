                                     FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="• Đặt mục tiêu nhỏ và có thể đạt được" 
                                     FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="• Chia sẻ thành công để tăng động lực" 
                                     FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
