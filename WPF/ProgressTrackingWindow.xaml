<Window x:Class="WPF.ProgressTrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="Theo dõi tiến độ - Smoking Cessation Platform" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Theo dõi tiến độ hàng ngày" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Ghi nhận tiến độ của bạn để theo dõi thành công" Style="{StaticResource SecondaryText}"/>
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Daily Tracking Form -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20">
                        <!-- Date Selection -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Chọn ngày ghi nhận" Style="{StaticResource SubHeaderText}"/>
                            <DatePicker x:Name="TrackingDatePicker" 
                                      SelectedDate="{x:Static System:DateTime.Today}"
                                      FontFamily="{StaticResource PrimaryFont}"
                                      FontSize="{StaticResource BodyFontSize}"
                                      xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                        </StackPanel>
                        
                        <!-- Smoking Status -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Tình trạng hút thuốc hôm nay" Style="{StaticResource SubHeaderText}"/>
                            <StackPanel Spacing="8">
                                <RadioButton x:Name="NoSmokingRadio" Content="Không hút thuốc" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           IsChecked="True"
                                           Checked="SmokingStatusChanged"/>
                                <RadioButton x:Name="LightSmokingRadio" Content="Hút ít hơn bình thường" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Checked="SmokingStatusChanged"/>
                                <RadioButton x:Name="NormalSmokingRadio" Content="Hút bình thường" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Checked="SmokingStatusChanged"/>
                                <RadioButton x:Name="HeavySmokingRadio" Content="Hút nhiều hơn bình thường" 
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Checked="SmokingStatusChanged"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Cigarette Count (conditional) -->
                        <StackPanel x:Name="CigaretteCountPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Số điếu thuốc đã hút" Style="{StaticResource SubHeaderText}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="CigaretteCountTextBox" 
                                       Style="{StaticResource ModernTextBox}"
                                       Width="100" 
                                       Text="0"/>
                                <TextBlock Text="điếu" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Mood Tracking -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Tâm trạng hôm nay" Style="{StaticResource SubHeaderText}"/>
                            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                                <Button x:Name="MoodVeryBad" Content="😢" FontSize="30" 
                                      Background="Transparent" BorderThickness="2" BorderBrush="{StaticResource DividerBrush}"
                                      Width="50" Height="50" 
                                      Click="MoodButton_Click" Tag="1"/>
                                <Button x:Name="MoodBad" Content="😔" FontSize="30" 
                                      Background="Transparent" BorderThickness="2" BorderBrush="{StaticResource DividerBrush}"
                                      Width="50" Height="50" 
                                      Click="MoodButton_Click" Tag="2"/>
                                <Button x:Name="MoodNeutral" Content="😐" FontSize="30" 
                                      Background="Transparent" BorderThickness="2" BorderBrush="{StaticResource DividerBrush}"
                                      Width="50" Height="50" 
                                      Click="MoodButton_Click" Tag="3"/>
                                <Button x:Name="MoodGood" Content="😊" FontSize="30" 
                                      Background="Transparent" BorderThickness="2" BorderBrush="{StaticResource DividerBrush}"
                                      Width="50" Height="50" 
                                      Click="MoodButton_Click" Tag="4"/>
                                <Button x:Name="MoodVeryGood" Content="😄" FontSize="30" 
                                      Background="Transparent" BorderThickness="2" BorderBrush="{StaticResource DividerBrush}"
                                      Width="50" Height="50" 
                                      Click="MoodButton_Click" Tag="5"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectedMoodText" Text="Chưa chọn" 
                                     Style="{StaticResource SecondaryText}" 
                                     HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Stress Level -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mức độ căng thẳng" Style="{StaticResource SubHeaderText}"/>
                            <Slider x:Name="StressLevelSlider" 
                                  Minimum="0" Maximum="10" Value="5" 
                                  TickPlacement="BottomRight" TickFrequency="1"
                                  ValueChanged="StressLevelSlider_ValueChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                <TextBlock Text="Không căng thẳng" FontSize="11" Opacity="0.7"/>
                                <TextBlock x:Name="StressLevelText" Text="5/10" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Rất căng thẳng" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Cravings -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Mức độ thèm thuốc" Style="{StaticResource SubHeaderText}"/>
                            <Slider x:Name="CravingLevelSlider" 
                                  Minimum="0" Maximum="10" Value="3" 
                                  TickPlacement="BottomRight" TickFrequency="1"
                                  ValueChanged="CravingLevelSlider_ValueChanged"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                <TextBlock Text="Không thèm" FontSize="11" Opacity="0.7"/>
                                <TextBlock x:Name="CravingLevelText" Text="3/10" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="Rất thèm" FontSize="11" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Physical Activity -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Hoạt động thể chất" Style="{StaticResource SubHeaderText}"/>
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="ExerciseCheckBox" Content="Tập thể dục" 
                                        FontFamily="{StaticResource PrimaryFont}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                                <CheckBox x:Name="WalkingCheckBox" Content="Đi bộ" 
                                        FontFamily="{StaticResource PrimaryFont}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                                <CheckBox x:Name="SportsCheckBox" Content="Chơi thể thao" 
                                        FontFamily="{StaticResource PrimaryFont}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                                <CheckBox x:Name="YogaCheckBox" Content="Yoga/Thiền" 
                                        FontFamily="{StaticResource PrimaryFont}"
                                        FontSize="{StaticResource BodyFontSize}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Thời gian hoạt động:" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ActivityDurationTextBox" 
                                       Style="{StaticResource ModernTextBox}"
                                       Width="80" 
                                       Text="0"/>
                                <TextBlock Text="phút" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Water Intake -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Lượng nước uống" Style="{StaticResource SubHeaderText}"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="WaterIntakeTextBox" 
                                       Style="{StaticResource ModernTextBox}"
                                       Width="100" 
                                       Text="0"/>
                                <TextBlock Text="ly nước (250ml)" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Notes -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="Ghi chú thêm" Style="{StaticResource SubHeaderText}"/>
                            <TextBox x:Name="NotesTextBox" 
                                   Style="{StaticResource ModernTextBox}"
                                   AcceptsReturn="True" 
                                   TextWrapping="Wrap" 
                                   Height="80"
                                   VerticalScrollBarVisibility="Auto"
                                   Text="Ví dụ: Cảm thấy khó khăn vào buổi sáng, nhưng đã vượt qua bằng cách uống trà xanh..."/>
                        </StackPanel>
                        
                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="Lưu tiến độ" 
                                  Style="{StaticResource PrimaryButton}"
                                  Padding="20,10"
                                  Click="SaveProgressButton_Click"/>
                            <Button Content="Đặt lại" 
                                  Style="{StaticResource SecondaryButton}"
                                  Padding="20,10"
                                  Click="ResetFormButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Right Panel - Progress Summary -->
            <StackPanel Grid.Column="1" Spacing="15">
                <!-- Weekly Summary -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Tóm tắt tuần này" Style="{StaticResource SubHeaderText}"/>
                        
                        <!-- Progress Ring -->
                        <Grid HorizontalAlignment="Center">
                            <Ellipse Width="120" Height="120" 
                                   Stroke="{StaticResource DividerBrush}" 
                                   StrokeThickness="8" 
                                   Fill="Transparent"/>
                            <Ellipse Width="120" Height="120" 
                                   Stroke="{StaticResource SuccessBrush}" 
                                   StrokeThickness="8" 
                                   Fill="Transparent"
                                   StrokeDashArray="75 25" 
                                   StrokeDashOffset="25" 
                                   RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="6/7" FontSize="24" FontWeight="Bold" 
                                         HorizontalAlignment="Center" 
                                         Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="ngày thành công" FontSize="11" 
                                         HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Weekly Stats -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Spacing="8">
                                <StackPanel>
                                    <TextBlock Text="Tâm trạng TB" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="😊 Tốt" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Căng thẳng TB" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="4/10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Spacing="8">
                                <StackPanel>
                                    <TextBlock Text="Thèm thuốc TB" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="3/10" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Tập thể dục" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Text="5 ngày" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Recent Entries -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                            <TextBlock Text="Ghi nhận gần đây" Style="{StaticResource SubHeaderText}"/>
                            <Button Content="Xem tất cả" 
                                  Style="{StaticResource SecondaryButton}"
                                  Padding="8,4" FontSize="11"
                                  Click="ViewAllEntriesButton_Click"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="10">
                            <!-- Entry 1 -->
                            <Border Background="#E8F5E8" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                        <TextBlock Text="Hôm qua" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="✅" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="Không hút thuốc • Tâm trạng tốt" FontSize="11" Opacity="0.8"/>
                                    <TextBlock Text="Tập thể dục 30 phút" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Entry 2 -->
                            <Border Background="#FFF3E0" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                        <TextBlock Text="2 ngày trước" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="⚠️" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="Hút 2 điếu • Căng thẳng cao" FontSize="11" Opacity="0.8"/>
                                    <TextBlock Text="Khó khăn trong ngày" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Entry 3 -->
                            <Border Background="#E8F5E8" CornerRadius="6" Padding="10">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                                        <TextBlock Text="3 ngày trước" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="✅" FontSize="14"/>
                                    </StackPanel>
                                    <TextBlock Text="Không hút thuốc • Thèm thuốc thấp" FontSize="11" Opacity="0.8"/>
                                    <TextBlock Text="Yoga 20 phút" FontSize="11" Opacity="0.8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Motivational Message -->
                <Border Style="{StaticResource Card}" Background="{StaticResource PrimaryLightBrush}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="🎯" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kiên trì sẽ thành công!" 
                                 Foreground="White" 
                                 FontWeight="Bold" 
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="Mỗi lần ghi nhận đều giúp bạn hiểu rõ hơn về hành trình cai thuốc." 
                                 Foreground="White" 
                                 TextWrapping="Wrap" 
                                 TextAlignment="Center"
                                 FontSize="12" 
                                 Opacity="0.9"/>
                    </StackPanel>
                </Border>
                
                <!-- Quick Tips -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="💡 Mẹo hôm nay" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="Hãy ghi nhận tiến độ vào cùng một thời điểm mỗi ngày để tạo thói quen tốt." 
                                 Style="{StaticResource BodyText}" 
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>