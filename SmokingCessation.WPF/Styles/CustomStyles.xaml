<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:SmokingCessation.WPF.Helpers">

    <!-- Converters -->
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <converters:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

    <!-- Custom Colors -->
    <SolidColorBrush x:Key="SmokeFreeGreen" Color="#4CAF50"/>
    <SolidColorBrush x:Key="DangerRed" Color="#F44336"/>
    <SolidColorBrush x:Key="WarningOrange" Color="#FF9800"/>
    <SolidColorBrush x:Key="InfoBlue" Color="#2196F3"/>
    <SolidColorBrush x:Key="LightGray" Color="#F5F5F5"/>

    <!-- Card Styles -->
    <Style x:Key="StatsCard" TargetType="materialDesign:Card" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2"/>
    </Style>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="18"/>
    </Style>

    <!-- Text Styles -->
    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline4TextBlock}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- Success Message Style -->
    <Style x:Key="SuccessMessage" TargetType="materialDesign:Card" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <Setter Property="Background" Value="{StaticResource SmokeFreeGreen}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Error Message Style -->
    <Style x:Key="ErrorMessage" TargetType="materialDesign:Card" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <Setter Property="Background" Value="{StaticResource DangerRed}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Achievement Badge Style -->
    <Style x:Key="AchievementBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SmokeFreeGreen}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- Progress Ring Style -->
    <Style x:Key="ProgressRing" TargetType="materialDesign:PackIcon" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Data Templates -->
    <DataTemplate x:Key="AchievementItemTemplate">
        <materialDesign:Card Style="{StaticResource StatsCard}" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
            <StackPanel>
                <materialDesign:PackIcon Kind="Trophy" 
                                       Width="32" 
                                       Height="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource SmokeFreeGreen}"/>
                <TextBlock Text="{Binding Title}" 
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          Margin="0,8,0,4"/>
                <TextBlock Text="{Binding Description}" 
                          Style="{StaticResource MaterialDesignCaptionTextBlock}"
                          HorizontalAlignment="Center"
                          TextWrapping="Wrap"
                          Opacity="0.7"/>
                <Border Style="{StaticResource AchievementBadge}"
                        Visibility="{Binding IsEarned, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <TextBlock Text="EARNED" 
                              Foreground="White"
                              FontWeight="Bold"
                              FontSize="10"/>
                </Border>
            </StackPanel>
        </materialDesign:Card>
    </DataTemplate>

    <DataTemplate x:Key="MessageItemTemplate">
        <materialDesign:Card Style="{StaticResource StatsCard}" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0"
                                       Kind="Message"
                                       Width="24"
                                       Height="24"
                                       VerticalAlignment="Top"
                                       Margin="0,0,12,0"
                                       Foreground="{Binding IsRead, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Gray|Blue'}"/>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Subject}"
                              Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                              FontWeight="{Binding IsRead, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Normal|Bold'}"/>
                    <TextBlock Text="{Binding SenderName}"
                              Style="{StaticResource MaterialDesignCaptionTextBlock}"
                              Opacity="0.7"/>
                    <TextBlock Text="{Binding Content}"
                              Style="{StaticResource MaterialDesignBody2TextBlock}"
                              TextTrimming="CharacterEllipsis"
                              MaxHeight="40"
                              Margin="0,4,0,0"/>
                </StackPanel>
                
                <TextBlock Grid.Column="2"
                          Text="{Binding TimeAgo}"
                          Style="{StaticResource MaterialDesignCaptionTextBlock}"
                          VerticalAlignment="Top"
                          Opacity="0.7"/>
            </Grid>
        </materialDesign:Card>
    </DataTemplate>

</ResourceDictionary>